{
  "name": "driftpad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "lint": "npm run typecheck",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json",
    "check": "npm test && npm run build",
    "benchmark:life": "tsx src/benchmarks/lifeGrid.bench.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
